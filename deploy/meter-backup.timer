# ตั้งเวลาสำรองข้อมูล

[Unit]
Description=Meter — ตั้งเวลาสำรอง Postgres

[Timer]
# ตี 3 ทุกวัน — ช่วงที่โรงงานเงียบที่สุด
OnCalendar=*-*-* 03:00:00
# ถ้าเครื่องดับตอนถึงเวลา ให้รันทันทีที่บูตกลับมา
# สำคัญกับ Pi ที่อาจโดนตัดไฟ — ไม่งั้นจะข้ามไปทั้งวันโดยไม่มีใครรู้
Persistent=true
# กระจายเวลาเล็กน้อย กันชนกับงานอื่นที่ตั้งเวลาเดียวกัน
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
