# ก๊อปเป็น .env แล้วแก้ค่า — .env ไม่ขึ้น git (ดู .gitignore)

# Postgres (รันใน Docker ผ่าน deploy/docker-compose.yml)
# POSTGRES_PASSWORD ถูกอ่านโดย compose ตอนสร้าง container ครั้งแรกเท่านั้น
# ส่วน DATABASE_URL แอปใช้ต่อ — รหัสผ่านสองที่นี้ต้องตรงกัน
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://meter:CHANGE_ME@localhost:5432/meter

# MQTT broker (dev รันใน Docker: container "meter-mqtt")
MQTT_URL=mqtt://localhost:1883

# prefix ของ topic — ทีม AI ยังไม่เคาะชื่อ เปลี่ยนที่นี่ได้โดยไม่ต้องแก้โค้ด
MQTT_TOPIC_PREFIX=meter

# พอร์ตของ Hono
PORT=3000

# --- ควบคุมปริมาณข้อมูล (ดู D-012) ---
# edge ยิงได้ถึง 26 เฟรม/วินาที ซึ่งเก็บทั้งหมดไม่มีประโยชน์และ SD เต็มใน ~23 วัน
INGEST_MIN_INTERVAL_MS=1000   # ไม่เก็บถี่กว่านี้ต่อจุด
INGEST_DEADBAND_PCT=0.5       # ค่าต้องขยับเกินกี่ % ของสเกลถึงเก็บ
INGEST_QUALITY_MIN_INTERVAL_MS=200  # เพดานตอนคุณภาพเปลี่ยน (ถี่กว่าปกติ แต่ไม่ไร้ขีดจำกัด)
INGEST_MAX_GAP_MS=60000       # บังคับเก็บอย่างน้อยทุกเท่านี้แม้ค่าไม่ขยับ
LIVE_EMIT_MIN_MS=250          # จำกัดอัตราส่งขึ้นจอ (คนละเรื่องกับการเก็บ)
RETENTION_DAYS=30             # ลบข้อมูลเก่ากว่านี้ ; 0 = ปิด

# --- สำรองข้อมูล (T-010 / D-006) ---
# BACKUP_DIR=/home/pi/meter-backups
# BACKUP_KEEP=7
# 🔴 ปลายทางนอกเครื่อง — ถ้าไม่ตั้ง backup จะอยู่บน SD ใบเดียวกับ DB
#    ซึ่งกันได้แค่ "ลบผิด" ไม่ได้กัน "การ์ดพัง" ที่เป็นความเสี่ยงหลักของเครื่องนี้
# BACKUP_REMOTE=user@nas:/backup/meter/
