# ก๊อปเป็น .env แล้วแก้ค่า — .env ไม่ขึ้น git (ดู .gitignore)

# Postgres (dev รันใน Docker: container "meter-postgres")
DATABASE_URL=postgres://meter:CHANGE_ME@localhost:5432/meter

# MQTT broker (dev รันใน Docker: container "meter-mqtt")
MQTT_URL=mqtt://localhost:1883

# prefix ของ topic — ทีม AI ยังไม่เคาะชื่อ เปลี่ยนที่นี่ได้โดยไม่ต้องแก้โค้ด
MQTT_TOPIC_PREFIX=meter

# พอร์ตของ Hono
PORT=3000
