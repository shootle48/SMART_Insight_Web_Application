{
  "name": "meter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "SERVE_STATIC=false bun --hot src/server/index.ts",
    "dev:web": "bunx vite",
    "build": "bunx vite build",
    "start": "bun src/server/index.ts",
    "mock-edge": "bun run scripts/mock-edge-publisher.ts",
    "verify-contract": "bun run scripts/verify-contract.ts",
    "type-check": "bunx tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "mqtt": "^5.15.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
