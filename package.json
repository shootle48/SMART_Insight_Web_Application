{
  "name": "meter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "SERVE_STATIC=false bun --hot src/server/index.ts",
    "dev:web": "bunx vite",
    "build": "bunx vite build",
    "start": "bun src/server/index.ts",
    "mock-edge": "bun run scripts/mock-edge-publisher.ts",
    "verify-contract": "bun run scripts/verify-contract.ts",
    "type-check": "bunx tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:studio": "bunx drizzle-kit studio",
    "smoke-db": "bun run scripts/smoke-db.ts",
    "smoke-ingest": "bun run scripts/smoke-ingest.ts",
    "purge-dev-seed": "bun run scripts/purge-dev-seed.ts",
    "db-peek": "bun run scripts/db-peek.ts",
    "smoke-throttle": "INGEST_MIN_INTERVAL_MS=800 INGEST_MAX_GAP_MS=30000 bun run scripts/smoke-throttle.ts",
    "smoke-retention": "bun run scripts/smoke-retention.ts",
    "stack:up": "docker compose --env-file .env -f deploy/docker-compose.yml up -d",
    "stack:down": "docker compose --env-file .env -f deploy/docker-compose.yml stop",
    "stack:status": "docker compose --env-file .env -f deploy/docker-compose.yml ps",
    "dev:all": "concurrently -k -n api,web,mock -c blue,green,magenta \"bun run dev:api\" \"bun run dev:web\" \"bun run mock-edge\""
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "mqtt": "^5.15.2",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
