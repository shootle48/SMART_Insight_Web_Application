# ของที่ต้องสร้างใหม่บนเครื่องปลายทางเสมอ
# node_modules ผูกกับ OS/สถาปัตยกรรม — ของ Windows x64 เอาไปรันบน Pi arm64 ไม่ได้
node_modules/
dist/

# ความลับ / ค่าเฉพาะเครื่อง
.env
.env.*
!.env.example

# ข้อมูลที่ container เขียน (mosquitto persistence ฯลฯ)
data/
*.log

# ขยะของ OS
.DS_Store
Thumbs.db

# รายงานหลักฐานการทดสอบ — ไฟล์เดียวจบแต่หนัก (~800KB เพราะฝังภาพหน้าจอเป็น data URI)
# Pi ต้อง pull repo นี้ทุกครั้งที่ deploy จึงไม่ควรลากไฟล์รายงานติดไปด้วย ไม่ได้ใช้ตอนรัน
# ตัวรายงานเผยแพร่เป็น artifact แทน (ลิงก์อยู่ใน CHANGELOG) ; สร้างใหม่ได้เสมอจากการรันเทสซ้ำ
docs/TEST-EVIDENCE-*.html
docs/INTEGRATION-MQTT-*.html
